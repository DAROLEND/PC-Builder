# Copy to .env (next to docker-compose.yml). Locally everything works without it;
# on a server DOMAIN and DJANGO_SECRET_KEY are required (see docs/DEPLOY.md).

# --- Server (docker-compose.prod.yml) -----------------------------------------
# DOMAIN=pcbuilder.example.com
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=pcbuilder.example.com,localhost,backend
# DJANGO_CSRF_TRUSTED_ORIGINS=https://pcbuilder.example.com
# FRONTEND_URL=https://pcbuilder.example.com
# SECURE_COOKIES=1
# Turn on after HTTPS works; browsers remember it (seconds).
# SECURE_HSTS_SECONDS=31536000

# --- AI advisor -----------------------------------------------------------------
# Without a key the rule-based planner answers instead.
ANTHROPIC_API_KEY=
# ADVISOR_MODEL=claude-opus-5
# ADVISOR_EFFORT=medium
# Site-wide cap on Claude calls per day (sign-up is open and calls cost money).
# ADVISOR_DAILY_LLM_LIMIT=100

# --- Payments ---------------------------------------------------------------------
# "fake" confirms instantly; "stripe" uses Stripe Checkout (test keys).
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Telegram price alerts --------------------------------------------------------
# Token from @BotFather. Without it the bot service idles and alerts are off.
TELEGRAM_BOT_TOKEN=

# --- Market data ------------------------------------------------------------------
# Requests to shop/aggregator sites. Keep 0 unless the source's terms or written
# permission allow automated collection (hotline.ua requires permission, p. 6.4).
MARKET_FETCH_ENABLED=0
# IMPORT_CATALOG_PAGES=0

# Supplier price feed for the nightly sync: "fixture" or an https URL.
PRICE_FEED_URL=fixture

# DJANGO_DEBUG=0
