# Copy to .env (optional). Everything works without it; these enable extras.

# AI advisor: without a key the rule-based planner answers instead.
ANTHROPIC_API_KEY=
# ADVISOR_MODEL=claude-opus-5
# ADVISOR_EFFORT=medium

# Payments: "fake" confirms instantly; "stripe" uses Stripe Checkout (test keys).
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supplier price feed for the nightly sync: "fixture" or an https URL.
PRICE_FEED_URL=fixture

# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=0
